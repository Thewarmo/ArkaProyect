# =============================================================================
# Arka Microservices - Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in your actual values
# IMPORTANT: Never commit .env file to Git! It contains sensitive credentials
# =============================================================================

# -----------------------------------------------------------------------------
# Docker Configuration
# -----------------------------------------------------------------------------
DOCKER_REGISTRY=ghcr.io/yourusername
TAG=latest
SPRING_PROFILES_ACTIVE=prod

# -----------------------------------------------------------------------------
# Git Configuration (Config Server)
# -----------------------------------------------------------------------------
CONFIG_GIT_URI=https://github.com/yourusername/arka-config-repo
CONFIG_GIT_BRANCH=main

# For private repositories, use a GitHub Personal Access Token:
# CONFIG_GIT_URI=https://<YOUR_GITHUB_TOKEN>@github.com/yourusername/arka-config-repo

# -----------------------------------------------------------------------------
# Railway PostgreSQL Database
# -----------------------------------------------------------------------------
# Get these values from Railway Dashboard → Database → Connect
RAILWAY_POSTGRES_URL=jdbc:postgresql://centerbeam.proxy.rlwy.net:34241/railway?sslmode=require
RAILWAY_POSTGRES_USER=postgres
RAILWAY_POSTGRES_PASSWORD=HMroWPVhjEVmVdDIPhhPABBtEbBKirFd

# Alternative format (if needed):
# RAILWAY_DATABASE_URL=postgresql://postgres:password@host:port/railway

# -----------------------------------------------------------------------------
# MongoDB Atlas
# -----------------------------------------------------------------------------
# Get this from MongoDB Atlas → Database → Connect → Connect your application
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_ATLAS_URI=mongodb+srv://arka_admin:YOUR_PASSWORD@arka-cluster.xxxxx.mongodb.net/arka_carts?retryWrites=true&w=majority

# -----------------------------------------------------------------------------
# CloudAMQP (RabbitMQ)
# -----------------------------------------------------------------------------
# Get this from CloudAMQP Dashboard → Instance Details → AMQP URL
# Format: amqps://<user>:<pass>@<host>/<vhost>
CLOUDAMQP_URL=amqps://user:password@chicken.rmq.cloudamqp.com/vhost

# -----------------------------------------------------------------------------
# Email Configuration (for Notification Service)
# -----------------------------------------------------------------------------
# Gmail App Password (https://support.google.com/accounts/answer/185833)
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# Alternative SMTP (e.g., SendGrid, Mailgun):
# MAIL_HOST=smtp.sendgrid.net
# MAIL_PORT=587
# MAIL_USERNAME=apikey
# MAIL_PASSWORD=your-sendgrid-api-key

# -----------------------------------------------------------------------------
# JWT Configuration
# -----------------------------------------------------------------------------
# Generate a strong random secret (at least 64 characters)
# You can use: openssl rand -base64 64
JWT_SECRET=ArkaSecretKeyForJWTTokenGenerationAndValidation2024!MustBeLongEnoughForHS256Algorithm

# JWT token expiration (in milliseconds)
# 86400000 = 24 hours, 3600000 = 1 hour
JWT_EXPIRATION=86400000

# -----------------------------------------------------------------------------
# Eureka Configuration
# -----------------------------------------------------------------------------
# Public hostname for Eureka registration (use EC2 public IP or domain)
EUREKA_HOSTNAME=ec2-xx-xx-xx-xx.compute-1.amazonaws.com

# -----------------------------------------------------------------------------
# Grafana Configuration
# -----------------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Grafana public URL (use your domain or EC2 public IP)
GRAFANA_ROOT_URL=http://ec2-xx-xx-xx-xx.compute-1.amazonaws.com:3000

# -----------------------------------------------------------------------------
# AWS EC2 Configuration (for CI/CD)
# -----------------------------------------------------------------------------
AWS_EC2_HOST=xx.xx.xx.xx
AWS_EC2_USER=ec2-user
# AWS_EC2_SSH_KEY will be stored in GitHub Secrets

# -----------------------------------------------------------------------------
# Optional: External Services
# -----------------------------------------------------------------------------

# Sentry (Error Tracking)
# SENTRY_DSN=https://xxxxx@o123456.ingest.sentry.io/123456

# New Relic (APM)
# NEW_RELIC_LICENSE_KEY=your-license-key
# NEW_RELIC_APP_NAME=arka-microservices

# Datadog (Monitoring)
# DD_API_KEY=your-datadog-api-key
# DD_SITE=datadoghq.com

# -----------------------------------------------------------------------------
# Resource Limits (Advanced)
# -----------------------------------------------------------------------------
# Adjust these if you have more/less RAM available
# Current values optimized for EC2 t2.micro (1GB RAM)

# JVM Memory per service (in MB)
# CONFIG_SERVER_MEMORY=128
# EUREKA_SERVER_MEMORY=128
# API_GATEWAY_MEMORY=128
# AUTH_SERVER_MEMORY=96
# BUSINESS_SERVICE_MEMORY=80

# -----------------------------------------------------------------------------
# Development Overrides
# -----------------------------------------------------------------------------
# Uncomment these for local development

# SPRING_PROFILES_ACTIVE=dev
# EUREKA_HOSTNAME=localhost
# RAILWAY_POSTGRES_URL=jdbc:postgresql://localhost:5432/arka_dev
# MONGODB_ATLAS_URI=mongodb://localhost:27017/arka_carts_dev
# CLOUDAMQP_URL=amqp://guest:guest@localhost:5672/

# -----------------------------------------------------------------------------
# Notes:
# -----------------------------------------------------------------------------
# 1. Railway PostgreSQL: Use the connection pooler URL for better performance
# 2. MongoDB Atlas: Whitelist 0.0.0.0/0 in Network Access for AWS EC2
# 3. CloudAMQP: Use amqpS (with S) for SSL connection
# 4. Gmail: Enable 2FA and create an App Password
# 5. JWT Secret: Must be at least 256 bits (32 bytes) for HS256
# 6. All services will use these environment variables via docker-compose